# Copy to .env for local development. Real environment variables always win,
# so a deployment is configured by its own environment, not by this file.

# --- Local development -----------------------------------------------------
DJANGO_DEBUG=1

# --- Production ------------------------------------------------------------
# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Required. The domain(s) this is served from, comma separated.
# DJANGO_ALLOWED_HOSTS=studio.example.com

# Only needed if the scheme or domain differs from the above.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://studio.example.com

# Postgres in production. Omitted means SQLite next to manage.py.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Uploaded fonts --------------------------------------------------------
# 'local' writes to DJANGO_MEDIA_ROOT. Only safe if that path is a durable
# volume; on a host with an ephemeral filesystem a redeploy deletes every
# uploaded font. 's3' works with AWS, Cloudflare R2, Backblaze B2, Spaces
# and MinIO.
# DJANGO_MEDIA_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=          # non-AWS S3-compatible hosts only
# AWS_S3_CUSTOM_DOMAIN=         # if the bucket is served from a CDN domain
# AWS_QUERYSTRING_AUTH=1        # 0 makes uploaded fonts publicly readable
# AWS_S3_SIGNATURE_VERSION=s3v4 # leave as s3v4; R2 accepts nothing else

# Or, with a persistent volume:
# DJANGO_MEDIA_ROOT=/data/media

# --- Optional --------------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=3600
# DJANGO_TIME_ZONE=UTC
# DJANGO_LOG_LEVEL=INFO
